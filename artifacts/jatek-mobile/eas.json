{
  "cli": {
    "version": ">=14.7.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_PROJECT_ID": "11e89fef-b97e-4823-ba4a-07c2942ba6b0",
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "PNPM_VERSION": "10.26.1",
        "EXPO_OWNER": "myjantesapps-team",
        "EXPO_SLUG": "jatekclient"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "11e89fef-b97e-4823-ba4a-07c2942ba6b0",
        "PNPM_VERSION": "10.26.1",
        "EXPO_OWNER": "myjantesapps-team",
        "EXPO_SLUG": "jatekclient"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_API_URL": "https://ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "11e89fef-b97e-4823-ba4a-07c2942ba6b0",
        "PNPM_VERSION": "10.26.1",
        "EXPO_OWNER": "myjantesapps-team",
        "EXPO_SLUG": "jatekclient"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
