# EAS build archive — exclude content not needed for the mobile build.
# The mobile app depends on lib/api-client-react (workspace:*) so lib/ must
# stay in the archive. Only exclude lib packages that are server-only.

# Other artifacts (not mobile)
artifacts/api-server/
artifacts/backend-dashboard/
artifacts/jatek-landing/
artifacts/jatek-driver/
artifacts/mockup-sandbox/

# Server-only lib packages (not imported by the mobile app)
lib/db/
lib/object-storage-web/

# Build outputs & generated files
artifacts/jatek-mobile/dist/
artifacts/jatek-mobile/.expo/
artifacts/jatek-mobile/server/
dist/

# Root tooling & local agent files
.husky/
.local/
.agents/
screenshots/

# Misc
*.log
.git/
.cache/
