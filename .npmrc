auto-install-peers=false
strict-peer-dependencies=false

# Hoist Babel, Metro and expo-updates to node_modules root so EAS Cloud
# (and pnpm's strict isolation) can resolve them during the native build step
# (createReleaseUpdatesResources / Metro bundling inside Gradle).
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=expo-updates
